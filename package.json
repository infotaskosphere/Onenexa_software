{
  "name": "taskosphere-commercial",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "lint": "npm run build:frontend",
    "desktop:dev": "concurrently -k \"npm run dev --workspace=frontend\" \"wait-on http://127.0.0.1:3000 && electron desktop/main.cjs\"",
    "desktop:pack": "npm run build:frontend && electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.prodigist.onenexa",
    "productName": "OneNexa",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend-dist/onenexa-backend.exe",
        "to": "backend/onenexa-backend.exe"
      },
      {
        "from": "build/onenexa.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/onenexa.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneNexa",
      "installerIcon": "build/onenexa.ico",
      "uninstallerIcon": "build/onenexa.ico"
    }
  }
}
