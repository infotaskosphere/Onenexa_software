# ==============================================================================
# Taskosphere / Finix / CompliGenie Environment Configuration (.env.example)
# Copy this file to .env and configure values as needed.
# All fields below are optional; sensible defaults and free tiers are built-in.
# ==============================================================================

# ── Server & Runtime ─────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Database (MongoDB) ───────────────────────────────────────────────────────
# Default: mongodb://localhost:27017/taskosphere
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=taskosphere

# ── Free GST API Configuration ───────────────────────────────────────────────
# The app includes a built-in Free Algorithmic & Public Registry Engine that works
# out-of-the-box with 0 keys and 0 cost.
# If you want to connect a custom free-tier provider, set below:
GST_API_PROVIDER=builtin_free          # Options: builtin_free, sheetgst, rapidapi, custom_gsp
GST_API_KEY=                           # Optional: Free tier key from sheet.gstincheck.co.in
SHEETGST_API_KEY=                      # Optional alias for SheetGST free key

# ── Enterprise GSP Portal Sync (Optional) ───────────────────────────────────
# Only needed if you have a contracted commercial GST Suvidha Provider (GSP).
# If left empty, the app automatically runs in Free GST API Mode.
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# ── AI Services (Optional) ───────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Frontend API Base (Optional) ────────────────────────────────────────────
# Only needed if hosting backend and frontend on separate hostnames
VITE_API_URL=
